@prefix an: <https://open-an.example/ontology/ip-network-fault-management#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://open-an.example/ontology/ip-network-fault-management> a owl:Ontology ;
  rdfs:label "IP网五层故障管理本体"@zh , "IP network five-layer fault-management ontology"@en ;
  rdfs:comment "完整导出业务运营、全局治理与主权、跨系统解决方案、逻辑资源、物理资源五层本体，以及 I-AADE 自治闭环和诊断关系；可离线导入 Agent。每条关系保留独立名称与单一 source/target，与演示页面 index.html 的 NODES/LINKS 一一对应。"@zh ; owl:versionInfo "1.0.0" .

an:OntologyConcept a owl:Class .
an:BusinessOperationConcept a owl:Class ; rdfs:subClassOf an:OntologyConcept ; rdfs:label "业务运营层概念"@zh .
an:GovernanceConcept a owl:Class ; rdfs:subClassOf an:OntologyConcept ; rdfs:label "全局治理与主权层概念"@zh .
an:CrossSystemConcept a owl:Class ; rdfs:subClassOf an:OntologyConcept ; rdfs:label "跨系统解决方案层概念"@zh .
an:LogicalResourceConcept a owl:Class ; rdfs:subClassOf an:OntologyConcept ; rdfs:label "逻辑资源层概念"@zh .
an:PhysicalResourceConcept a owl:Class ; rdfs:subClassOf an:OntologyConcept ; rdfs:label "物理资源层概念"@zh .
an:OntologyRelation a owl:Class .
an:StructuralRelation a owl:Class ; rdfs:subClassOf an:OntologyRelation .
an:ReasoningRelation a owl:Class ; rdfs:subClassOf an:OntologyRelation .
an:EvidenceRelation a owl:Class ; rdfs:subClassOf an:OntologyRelation .
an:DiagnosisRelation a owl:Class ; rdfs:subClassOf an:OntologyRelation .
an:inLayer a owl:ObjectProperty . an:hasSource a owl:ObjectProperty . an:hasTarget a owl:ObjectProperty .

an:BusinessOperationLayer rdfs:label "业务运营层"@zh .
an:GovernanceLayer rdfs:label "全局治理与主权层"@zh .
an:CrossSystemLayer rdfs:label "跨系统解决方案层"@zh .
an:LogicalResourceLayer rdfs:label "逻辑资源层"@zh .
an:PhysicalResourceLayer rdfs:label "物理资源层"@zh .

# Layer 1: business operation
an:ODABusiness a an:BusinessOperationConcept ; an:inLayer an:BusinessOperationLayer ; rdfs:label "ODA商业面"@zh .
an:MarketProduct a an:BusinessOperationConcept ; an:inLayer an:BusinessOperationLayer ; rdfs:label "市场/产品/客户流"@zh .
an:SLAContract a an:BusinessOperationConcept ; an:inLayer an:BusinessOperationLayer ; rdfs:label "SLA标准与契约"@zh .
an:BaseStationSvc a an:BusinessOperationConcept ; an:inLayer an:BusinessOperationLayer ; rdfs:label "基站业务保障"@zh .
an:DedicatedLineSvc a an:BusinessOperationConcept ; an:inLayer an:BusinessOperationLayer ; rdfs:label "专线业务保障"@zh .

# Layer 2: governance and sovereignty
an:ODAGovernance a an:GovernanceConcept ; an:inLayer an:GovernanceLayer ; rdfs:label "ODA治理面"@zh .
an:SecurityRedLine a an:GovernanceConcept ; an:inLayer an:GovernanceLayer ; rdfs:label "安全红线"@zh .
an:ResourceAllocation a an:GovernanceConcept ; an:inLayer an:GovernanceLayer ; rdfs:label "资源分配与冲突控制"@zh .
an:ETOMFramework a an:GovernanceConcept ; an:inLayer an:GovernanceLayer ; rdfs:label "运营商eTOM"@zh .
an:CrossLayerMapping a an:GovernanceConcept ; an:inLayer an:GovernanceLayer ; rdfs:label "上下层本体交叉"@zh .

# Layer 3: IP-network solution and I-AADE autonomous loop
an:DomainIPNetwork a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "IP网"@zh .
an:ServiceFaultManagement a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "故障管理"@zh .
an:ServiceQualityOptimization a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "质量优化"@zh .
an:TaskPolicyIntent a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "故障管理策略生成(Intent)"@zh .
an:TaskFaultAwareness a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "故障识别(Awareness)"@zh .
an:TaskRiskAnalysis a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "隐患预测(Analysis)"@zh .
an:TaskProblemAnalysis a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "问题定界定位（含影响性分析）(Analysis)"@zh .
an:TaskSolutionDecision a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "方案生成并决策(Decision)"@zh .
an:TaskRepairExecution a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "问题修复并验证(Execution)"@zh .
an:CatDevice a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "设备类故障"@zh .
an:CatConnection a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "连接类故障"@zh .
an:CatService a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "业务类故障"@zh .
an:CatClock a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "时钟类故障"@zh .
an:CatEnvironment a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "环境类故障"@zh .
an:CatProtocol a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "协议类故障"@zh .
an:CatCrossDomain a an:CrossSystemConcept ; an:inLayer an:CrossSystemLayer ; rdfs:label "跨专业故障"@zh .

# Layer 4: logical resources
an:DeviceOffline a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "设备离线"@zh .
an:LinkFault a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "链路/连接故障"@zh .
an:ClockFault a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "时钟异常"@zh .
an:ProtocolFault a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "协议类故障"@zh .
an:TunnelFault a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "隧道故障"@zh .
an:FiveGNRM a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "5G NRM"@zh .
an:ResourceAnomaly a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "资源消耗异常"@zh .
an:SoftwareFault a an:LogicalResourceConcept ; an:inLayer an:LogicalResourceLayer ; rdfs:label "软件/配置故障"@zh .

# Layer 5: physical resources
an:FiberFault a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "光纤/尾纤故障"@zh .
an:PowerFault a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "供电/掉电故障"@zh .
an:BoardFault a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "单板/主控板故障"@zh .
an:OpticalModule a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "光模块故障"@zh .
an:FanEnvFault a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "风扇/环境故障"@zh .
an:PortFault a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "端口物理故障"@zh .
an:CableInfra a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "机架/线缆基础设施"@zh .
an:SitePowerCool a an:PhysicalResourceConcept ; an:inLayer an:PhysicalResourceLayer ; rdfs:label "站点动环"@zh .

# 结构关系（43）
an:r01 a an:StructuralRelation ; rdfs:label "IP网包含故障管理"@zh ; an:hasSource an:DomainIPNetwork ; an:hasTarget an:ServiceFaultManagement .
an:r02 a an:StructuralRelation ; rdfs:label "IP网包含质量优化"@zh ; an:hasSource an:DomainIPNetwork ; an:hasTarget an:ServiceQualityOptimization .
an:r03 a an:StructuralRelation ; rdfs:label "故障管理包含策略生成"@zh ; an:hasSource an:ServiceFaultManagement ; an:hasTarget an:TaskPolicyIntent .
an:r04 a an:StructuralRelation ; rdfs:label "故障管理包含故障识别"@zh ; an:hasSource an:ServiceFaultManagement ; an:hasTarget an:TaskFaultAwareness .
an:r05 a an:StructuralRelation ; rdfs:label "故障管理包含隐患预测"@zh ; an:hasSource an:ServiceFaultManagement ; an:hasTarget an:TaskRiskAnalysis .
an:r06 a an:StructuralRelation ; rdfs:label "故障管理包含定界定位"@zh ; an:hasSource an:ServiceFaultManagement ; an:hasTarget an:TaskProblemAnalysis .
an:r07 a an:StructuralRelation ; rdfs:label "故障管理包含方案决策"@zh ; an:hasSource an:ServiceFaultManagement ; an:hasTarget an:TaskSolutionDecision .
an:r08 a an:StructuralRelation ; rdfs:label "故障管理包含修复验证"@zh ; an:hasSource an:ServiceFaultManagement ; an:hasTarget an:TaskRepairExecution .
an:r09 a an:StructuralRelation ; rdfs:label "定界定位包含设备类"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:CatDevice .
an:r10 a an:StructuralRelation ; rdfs:label "定界定位包含连接类"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:CatConnection .
an:r11 a an:StructuralRelation ; rdfs:label "定界定位包含业务类"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:CatService .
an:r12 a an:StructuralRelation ; rdfs:label "定界定位包含时钟类"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:CatClock .
an:r13 a an:StructuralRelation ; rdfs:label "定界定位包含环境类"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:CatEnvironment .
