an:r53 a an:ReasoningRelation ; rdfs:label "时钟状态影响业务"@zh ; an:hasSource an:CatClock ; an:hasTarget an:CatService .
an:r54 a an:ReasoningRelation ; rdfs:label "连接质量影响业务"@zh ; an:hasSource an:CatConnection ; an:hasTarget an:CatService .
an:r55 a an:ReasoningRelation ; rdfs:label "外部条件影响运行环境"@zh ; an:hasSource an:CatCrossDomain ; an:hasTarget an:CatEnvironment .
an:r56 a an:ReasoningRelation ; rdfs:label "跨专业状态影响连接"@zh ; an:hasSource an:CatCrossDomain ; an:hasTarget an:CatConnection .
an:r57 a an:ReasoningRelation ; rdfs:label "跨专业信息关联业务"@zh ; an:hasSource an:CatCrossDomain ; an:hasTarget an:CatService .

