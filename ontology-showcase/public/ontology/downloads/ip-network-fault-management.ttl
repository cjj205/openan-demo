an:r15 a an:StructuralRelation ; rdfs:label "定界定位包含跨专业类"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:CatCrossDomain .
an:r16 a an:StructuralRelation ; rdfs:label "治理→设备方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatDevice .
an:r17 a an:StructuralRelation ; rdfs:label "治理→连接方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatConnection .
an:r18 a an:StructuralRelation ; rdfs:label "治理→业务方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatService .
an:r19 a an:StructuralRelation ; rdfs:label "治理→时钟方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatClock .
an:r20 a an:StructuralRelation ; rdfs:label "治理→环境方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatEnvironment .
an:r21 a an:StructuralRelation ; rdfs:label "治理→协议方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatProtocol .
an:r22 a an:StructuralRelation ; rdfs:label "治理→跨专业方案"@zh ; an:hasSource an:ODAGovernance ; an:hasTarget an:CatCrossDomain .
an:r23 a an:StructuralRelation ; rdfs:label "安全→跨专业约束"@zh ; an:hasSource an:SecurityRedLine ; an:hasTarget an:CatCrossDomain .
an:r24 a an:StructuralRelation ; rdfs:label "安全→设备约束"@zh ; an:hasSource an:SecurityRedLine ; an:hasTarget an:CatDevice .
an:r25 a an:StructuralRelation ; rdfs:label "资源→业务调度"@zh ; an:hasSource an:ResourceAllocation ; an:hasTarget an:CatService .
an:r26 a an:StructuralRelation ; rdfs:label "资源→跨专业调度"@zh ; an:hasSource an:ResourceAllocation ; an:hasTarget an:CatCrossDomain .
an:r27 a an:StructuralRelation ; rdfs:label "eTOM→业务映射"@zh ; an:hasSource an:ETOMFramework ; an:hasTarget an:CatService .
an:r28 a an:StructuralRelation ; rdfs:label "eTOM→跨专业映射"@zh ; an:hasSource an:ETOMFramework ; an:hasTarget an:CatCrossDomain .
an:r29 a an:StructuralRelation ; rdfs:label "eTOM→环境映射"@zh ; an:hasSource an:ETOMFramework ; an:hasTarget an:CatEnvironment .
an:r30 a an:StructuralRelation ; rdfs:label "交叉→设备层映射"@zh ; an:hasSource an:CrossLayerMapping ; an:hasTarget an:CatDevice .
an:r31 a an:StructuralRelation ; rdfs:label "交叉→连接层映射"@zh ; an:hasSource an:CrossLayerMapping ; an:hasTarget an:CatConnection .
