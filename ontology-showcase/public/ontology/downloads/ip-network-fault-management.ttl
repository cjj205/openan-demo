an:r33 a an:StructuralRelation ; rdfs:label "交叉→协议层映射"@zh ; an:hasSource an:CrossLayerMapping ; an:hasTarget an:CatProtocol .
an:r34 a an:StructuralRelation ; rdfs:label "商业→治理依赖"@zh ; an:hasSource an:ODABusiness ; an:hasTarget an:ODAGovernance .
an:r35 a an:StructuralRelation ; rdfs:label "商业→eTOM依赖"@zh ; an:hasSource an:ODABusiness ; an:hasTarget an:ETOMFramework .
an:r36 a an:StructuralRelation ; rdfs:label "市场→eTOM流程"@zh ; an:hasSource an:MarketProduct ; an:hasTarget an:ETOMFramework .
an:r37 a an:StructuralRelation ; rdfs:label "市场→层间映射"@zh ; an:hasSource an:MarketProduct ; an:hasTarget an:CrossLayerMapping .
an:r38 a an:StructuralRelation ; rdfs:label "SLA→资源策略"@zh ; an:hasSource an:SLAContract ; an:hasTarget an:ResourceAllocation .
an:r39 a an:StructuralRelation ; rdfs:label "SLA→安全策略"@zh ; an:hasSource an:SLAContract ; an:hasTarget an:SecurityRedLine .
an:r40 a an:StructuralRelation ; rdfs:label "基站→治理依赖"@zh ; an:hasSource an:BaseStationSvc ; an:hasTarget an:ODAGovernance .
an:r41 a an:StructuralRelation ; rdfs:label "基站→安全依赖"@zh ; an:hasSource an:BaseStationSvc ; an:hasTarget an:SecurityRedLine .
an:r42 a an:StructuralRelation ; rdfs:label "专线→资源依赖"@zh ; an:hasSource an:DedicatedLineSvc ; an:hasTarget an:ResourceAllocation .
an:r43 a an:StructuralRelation ; rdfs:label "专线→治理依赖"@zh ; an:hasSource an:DedicatedLineSvc ; an:hasTarget an:ODAGovernance .

# 推理关系（14）
an:r44 a an:ReasoningRelation ; rdfs:label "策略驱动故障识别"@zh ; an:hasSource an:TaskPolicyIntent ; an:hasTarget an:TaskFaultAwareness .
an:r45 a an:ReasoningRelation ; rdfs:label "故障流进入定界定位"@zh ; an:hasSource an:TaskFaultAwareness ; an:hasTarget an:TaskProblemAnalysis .
an:r46 a an:ReasoningRelation ; rdfs:label "隐患流进入定界定位"@zh ; an:hasSource an:TaskRiskAnalysis ; an:hasTarget an:TaskProblemAnalysis .
an:r47 a an:ReasoningRelation ; rdfs:label "定界定位支撑方案决策"@zh ; an:hasSource an:TaskProblemAnalysis ; an:hasTarget an:TaskSolutionDecision .
an:r48 a an:ReasoningRelation ; rdfs:label "方案决策驱动修复验证"@zh ; an:hasSource an:TaskSolutionDecision ; an:hasTarget an:TaskRepairExecution .
an:r49 a an:ReasoningRelation ; rdfs:label "修复验证反馈策略"@zh ; an:hasSource an:TaskRepairExecution ; an:hasTarget an:TaskPolicyIntent .
an:r50 a an:ReasoningRelation ; rdfs:label "环境变化影响设备运行"@zh ; an:hasSource an:CatEnvironment ; an:hasTarget an:CatDevice .
an:r51 a an:ReasoningRelation ; rdfs:label "设备状态影响连接"@zh ; an:hasSource an:CatDevice ; an:hasTarget an:CatConnection .
