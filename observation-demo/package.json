{
  "name": "a2a-screen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:preview": "vite build && electron .",
    "dist:exe": "vite build && electron-builder --win portable",
    "build:browser": "vite build && node scripts/build-browser.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "com.collab.observability",
    "productName": "A2A-Observability-Demo",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "dist/**/*"],
    "electronDist": "electron-dist",
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "win": { "target": ["portable"] }
  }
}
