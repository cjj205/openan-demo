{
  "id": "livestream-stub",
  "name": "直播打桩 Agent",
  "organization": "OpenAN-Stub",
  "description": "直播智能体打桩：直播业务质量诊断（卡顿/花屏/延迟/断流）；优先检索数据集返回最接近的成对响应",
  "layer": "service",
  "port": 9009,
  "workDir": "data/mock_agents/livestream-stub",
  "autoStart": false,
  "llm": {
    "enabled": true,
    "provider": "openai",
    "baseUrl": "http://127.0.0.1:8000/v1",
    "model": "qwen2.5-7b-instruct",
    "apiKeyEnv": "MOCK_AGENT_LLM_API_KEY",
    "maxAttempts": 1,
    "language": "zh-CN"
  },
  "stubVariants": [
    {
      "templateUri": "Task-T/network-layer/live-stream-quality/v1",
      "variantJson": {
        "artifactName": "live-stream-quality-result",
        "artifactPrompt": "1. 诊断结果：成功\n2. 诊断结果详细信息：直播间 ROOM-73001（赛事直播）观众端卡顿率升至5.8%，下行码率波动明显。\n3. 修复建议：降低转码码率档位并检查CDN调度策略。\n4. 故障根因列表：\n   - 故障根因名称：CDN分发异常，详细描述：CDN边缘节点调度异常导致下行码率波动，修复建议：降低转码码率档位并检查CDN调度策略，故障根因点位置：CDN_NODE {{caseId}}，故障对象类型：CDN_NODE"
      }
    },
    {
      "templateUri": "Task-T/network-layer/live-stream-quality/v1",
      "variantJson": {
        "artifactName": "live-stream-quality-result",
        "artifactPrompt": "1. 诊断结果：成功\n2. 诊断结果详细信息：直播间各项质量指标正常，未诊断到直播质量故障。\n3. 修复建议：未诊断到业务故障，请人工接管。"
      }
    }
  ],
  "datasetTemplates": [
    "Task-T/network-layer/live-stream-quality/v1"
  ],
  "cardName": "mockagent_livestream-stub"
