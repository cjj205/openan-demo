{
  "name": "mockagent_an-l4-service-delivery-agent",
  "description": "面向个人移动业务的自动开通与交付：业务订单受理、开通编排、交付验证与激活。",
  "version": "1.0.0",
  "defaultInputModes": [
    "application/json",
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json",
    "text/plain"
  ],
  "provider": {
    "organization": "OpenAN-Stub",
    "url": "https://github.com/project-openan"
  },
  "skills": [
    {
      "id": "service-order-intake",
      "name": "Service Order Intake",
      "description": "受理个人移动业务开通订单，进行订单解析与合法性校验。",
      "tags": [
        "service-delivery",
        "order"
      ]
    },
    {
      "id": "service-provisioning-orchestration",
      "name": "Service Provisioning Orchestration",
      "description": "编排各网域执行业务开通配置与参数下发。",
      "tags": [
        "service-delivery",
        "provisioning"
      ]
    },
    {
      "id": "service-delivery-verification",
      "name": "Service Delivery Verification and Activation",
      "description": "执行业务交付验证（拨测/签约核查）并完成业务激活。",
      "tags": [
        "service-delivery",
        "verification"
      ]
    }
  ],
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Task-T/v1",
        "description": "Task-T structured prompt requests"
      },
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Notification-T/v1",
        "description": "Notification-T structured prompt requests"
      },
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Authorization-T/v1",
        "description": "Authorization-T structured prompt requests"
      },
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Negotiation-T/v1",
        "description": "Negotiation-T structured prompt messages"
      }
    ]
  },
  "supportedInterfaces": [
    {
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0.0",
      "url": "http://127.0.0.1:9300/agents/an-l4-service-delivery-agent"
    },
    {
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0.0",
      "url": "http://127.0.0.1:9118"
    }
  ]
}
