{
  "name": "mockagent_an-l4-work-order-management-agent",
  "description": "负责工单全生命周期管理：工单创建、派发、跟踪与关闭，支撑无法自动修复场景的人工处置。",
  "version": "1.0.0",
  "defaultInputModes": [
    "application/json",
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json",
    "text/plain"
  ],
  "provider": {
    "organization": "OpenAN-Stub",
    "url": "https://github.com/project-openan"
  },
  "skills": [
    {
      "id": "work-order-creation",
      "name": "Work Order Creation",
      "description": "根据故障或投诉处理需要创建人工处置工单。",
      "tags": [
        "work-order",
        "creation"
      ]
    },
    {
      "id": "work-order-dispatch",
      "name": "Work Order Dispatch",
      "description": "将工单派发到对应作业班组（如FME）并跟踪接单。",
      "tags": [
        "work-order",
        "dispatch"
      ]
    },
    {
      "id": "work-order-tracking",
      "name": "Work Order Tracking and Closure",
      "description": "跟踪工单处理进展并在处理完成后关闭工单、归档结果。",
      "tags": [
        "work-order",
        "tracking"
      ]
    }
  ],
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Task-T/v1",
        "description": "Task-T structured prompt requests"
      },
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Notification-T/v1",
        "description": "Notification-T structured prompt requests"
      },
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Authorization-T/v1",
        "description": "Authorization-T structured prompt requests"
      },
      {
        "uri": "https://projects.tmforum.org/a2aproject/telecommunication/extensions/Negotiation-T/v1",
        "description": "Negotiation-T structured prompt messages"
      }
    ]
  },
  "supportedInterfaces": [
    {
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0.0",
      "url": "http://127.0.0.1:9300/agents/an-l4-work-order-management-agent"
    },
    {
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0.0",
      "url": "http://127.0.0.1:9120"
    }
  ]
}
